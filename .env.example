# OpenAI-compatible LLM endpoint — powers mock-interview feedback and job-posting AI assist.
# Without a key, the AI routes fall back to built-in heuristics.
AI_API_KEY=
AI_BASE_URL=https://api.scalemax.pro/token/v1
AI_MODEL=gpt-5.6-luna

# PostgreSQL (used by Prisma; not required to run the UI prototype)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uddaya
